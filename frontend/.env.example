# ===================================================================
# NutriVerify Frontend Environment Configuration (.env.example)
# Only variables prefixed with VITE_ are exposed to the browser.
# ===================================================================

# Deployed Backend Public API URL (e.g. https://nutriverify-backend.onrender.com)
# In local development with Vite proxy, leave empty to use relative /api/v1
VITE_API_BASE_URL=https://your-nutriverify-backend.onrender.com

# Google OAuth2 Client ID for Sign-In with Google
VITE_GOOGLE_CLIENT_ID=
