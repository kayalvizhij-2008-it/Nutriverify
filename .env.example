# NutriVerify Environment Variables
# Copy this file to .env and fill in the values

# ── Required for Production ──
# JWT secret key (minimum 32 characters for HS256)
NUTRIVERIFY_JWT_SECRET=your-secret-key-here-change-in-production

# ── Database ──
# Uncomment for PostgreSQL in production
# DATABASE_URL=jdbc:postgresql://localhost:5432/nutriverify
# DATABASE_USERNAME=nutriverify
# DATABASE_PASSWORD=your-db-password

# ── CORS ──
# Allowed origins (comma-separated)
NUTRIVERIFY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Optional: AI Provider ──
# AI_API_KEY=your-openai-or-anthropic-api-key

# ── Optional: OCR/Vision Provider ──
# OCR_API_KEY=your-ocr-provider-api-key
# VISION_API_KEY=your-vision-provider-api-key

# ── Optional: Speech Providers ──
# SPEECH_API_KEY=your-speech-to-text-api-key
# TTS_API_KEY=your-text-to-speech-api-key
