# ===================================================================
# NutriVerify Production Environment Configuration (.env.example)
# ===================================================================

# ── Server & Profile ──
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── PostgreSQL Production Database ──
# Direct JDBC connection string or Cloud DB URI
DATABASE_URL=jdbc:postgresql://localhost:5432/nutriverify
DATABASE_USERNAME=nutriverify
DATABASE_PASSWORD=your_secure_production_password_here

# ── Security & JWT ──
# Must be at least 32 characters for HMAC-SHA256 signature
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# ── Cross-Origin Resource Sharing (CORS) ──
# Comma-separated list of allowed frontend domains, or * for open CORS
NUTRIVERIFY_CORS_ALLOWED_ORIGINS=https://nutriverify.vercel.app,https://nutriverify.onrender.com,http://localhost:5173

# ── Optional: External AI Provider (OpenAI / Claude / Groq) ──
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-...
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=10000

# ── Optional: External Vision & OCR ──
OCR_API_KEY=
VISION_API_KEY=

# ── Optional: Speech / Voice Saathi ──
SPEECH_API_KEY=
TTS_API_KEY=
